{
  "name": "wick",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wick — the television as the care surface for the person being cared for.",
  "license": "MIT",
  "author": "Roger Bavibidila",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "services/connectors/*",
    "apps/tv-vega"
  ],
  "scripts": {
    "postinstall": "simple-git-hooks",
    "build:lambda": "node scripts/build-lambda.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:no-mocks": "node scripts/check-no-mocks.mjs",
    "demo:capture": "vite-node -c vitest.config.ts scripts/capture-event-frame.ts",
    "demo:door": "vite-node -c vitest.config.ts scripts/door-card-demo.ts",
    "addon:check": "vite-node -c vitest.config.ts scripts/addon-check.ts --",
    "smoke:live": "vite-node -c vitest.config.ts scripts/smoke-live.ts",
    "ops:status": "vite-node -c vitest.config.ts scripts/ops-status.ts",
    "latency:door": "vite-node -c vitest.config.ts scripts/door-latency.ts --",
    "latency:mcp": "vite-node -c vitest.config.ts scripts/mcp-latency.ts --",
    "vvd:follow": "vite-node -c vitest.config.ts scripts/vvd-follow/run.ts",
    "vvd:follow:watch": "vite-node -c vitest.config.ts scripts/vvd-follow/agent.ts",
    "vvd:follow:stop": "vite-node -c vitest.config.ts scripts/vvd-follow/agent.ts -- --stop",
    "deploy:wait-app-runner": "vite-node -c vitest.config.ts scripts/wait-for-app-runner.ts",
    "calm:measure": "scripts/calm-points/measure.sh",
    "calm:describe": "vite-node -c vitest.config.ts scripts/calm-points/describe.ts && npm run calm:build",
    "calm:build": "vite-node -c vitest.config.ts scripts/calm-points/cli.ts",
    "pages:vendor": "node scripts/pages-vendor.mjs",
    "phrasebook:build": "node scripts/build-phrasebook.mjs",
    "speech:build": "node scripts/build-speech.mjs",
    "tv:build": "vite-node -c vitest.config.ts scripts/tv-page/cli.ts",
    "family:vendor": "node scripts/family-vendor.mjs",
    "ring:check": "vite-node -c vitest.config.ts scripts/ring-camera-check.ts",
    "demo:mcp-seed": "vite-node -c vitest.config.ts scripts/seed-mcp-stub-data.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:property": "vitest run evaluate.property guardian.property NaturalBreakEngine",
    "test:watch": "vitest",
    "tf:apply": "terraform -chdir=infra apply",
    "tf:fmt": "terraform -chdir=infra fmt -recursive",
    "tf:plan": "terraform -chdir=infra plan",
    "typecheck": "tsc -b --pretty",
    "typecheck:scripts": "tsc -p scripts --pretty",
    "typecheck:vega": "tsc -b apps/tv-vega --pretty",
    "verify": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm run check:no-mocks && npm run test"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@types/node": "^22.0.0",
    "@types/react-test-renderer": "19.3.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.21.5",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.0",
    "lucide-static": "1.51.0",
    "motion": "13.5.1",
    "open-props": "1.7.23",
    "react-test-renderer": "19.3.0",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.0"
  },
  "comment:overrides": [
    "Several @amazon-devices/* SDK packages (headless-task-manager,",
    "kepler-content-personalization, kepler-media-controls,",
    "kepler-cli-platform, react-native-w3cmedia) declare a loose peer dep on",
    "react-native that resolves to 0.87.1 (latest) on the public registry.",
    "@amazon-devices/react-native-kepler itself — the actual Vega runtime",
    "bridge — is explicitly built against 0.83.0 (its own version string is",
    "4.0.1+rn0.83.0). The split produces a real build failure: 0.87.1 ships",
    "Flow syntax Metro/Hermes 0.83's parser can't read. Force the whole tree",
    "to 0.83.0 — verified 2026-09-19 against a real `vega build`."
  ],
  "overrides": {
    "react-native": "0.83.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check:secrets && npm run typecheck && npm run typecheck:scripts"
  }
}
