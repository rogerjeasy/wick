default-src 'none';
script-src 'self' https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.light.min.js;
style-src 'self';
img-src 'self' data: blob: https:;
media-src 'self' blob: ${films};
connect-src 'self' ${wick_server} ${films};
worker-src 'self' blob:;
manifest-src 'self';
base-uri 'none';
form-action 'self';
frame-ancestors 'none'
