# Wick — local-development environment.
#
# Copy to .env (gitignored) and fill in only what you need. .env is read by
# scripts/env.ts and by the shell scripts named below, on a laptop, and by
# nothing deployed: never bake it into an image (AGENTS.md, credential rules).
# Nothing is needed to run `npm run verify` or the local dev server.

# --- AWS (scripts/env.ts) ---------------------------------------------------
# A credential your shell already has wins over anything here. Prefer a named
# profile; if none is set here or in the shell, scripts/env.ts uses the
# profile `wick-dev` from ~/.aws when it exists.

# Named profile to use.
AWS_PROFILE=
# Region. Defaults to us-east-1, where the stack is deployed.
AWS_REGION=
# Access keys, only if you do not use a profile. AWS_ACCESS_KEY and
# AWS_SECRET_KEY are accepted as aliases and mapped to these names.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only with temporary credentials.
AWS_SESSION_TOKEN=

# --- Which household a laptop script acts for (scripts/env.ts) -------------
# A household id (hh_…). Scripts that need a Ring token read this household's
# link from Secrets Manager (wick/ring/tokens/<householdId>) when
# RING_OAUTH_TOKEN below is empty. scripts/set-ring-token.sh writes to it.
WICK_HOUSEHOLD_ID=

# --- Ring (scripts/env.ts) ---------------------------------------------------
# A Ring Developer Playground token, for a quick one-off. Lasts 30 minutes and
# cannot be refreshed (FRICTION.md FL-010). When set, it wins over the
# household's link. https://developer.amazon.com/ring/console/playground
RING_OAUTH_TOKEN=

# --- Ring app credentials (infra/bootstrap/put-ring-secret.sh) --------------
# From your app in the Ring developer console. put-ring-secret.sh copies them
# into Secrets Manager once; nothing deployed reads this file.
# Client id of your Ring app.
CLIENT_ID_RING=
# Client secret of your Ring app.
CLIENT_SECRET_RING=
# The key Ring signs webhooks with (HMAC-SHA256). Also used by
# scripts/test-ring-webhook.sh and scripts/visit-sighting.sh to sign a test event.
HMAC_KEY_RING=
